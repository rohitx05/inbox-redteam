    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ALLOWED_FORWARD = ['billing@acmesaas.com', 'support@acmesaas.com'];\nconst ALLOWED_ACTIONS = ['none', 'escalate', 'forward'];\nconst ALLOWED_CATEGORIES = ['billing', 'bug', 'sales', 'support', 'other'];\n\nconst r = { ...$json };\nconst flags = [];\n\n// 1. Recipient allowlist: exact match only\nconst fwd = String(r.forward_to || '').trim().toLowerCase();\nif (fwd && !ALLOWED_FORWARD.includes(fwd)) {\n  flags.push(`blocked_forward:${fwd}`);\n  r.forward_to = '';\n  r.action = 'escalate';           // send to a human instead of silently dropping\n}\nif (r.action === 'forward' && !r.forward_to) r.action = 'escalate';\n\n// 2. Enum checks\nif (!ALLOWED_ACTIONS.includes(r.action)) { flags.push(`bad_action:${r.action}`); r.action = 'escalate'; }\nif (!ALLOWED_CATEGORIES.includes(r.category)) { flags.push(`bad_category:${r.category}`); r.category = 'other'; }\n\n// 3. Strip links from the draft reply\nconst urlPattern = /(https?:\\/\\/\\S+|www\\.\\S+|\\b[\\w-]+\\.(com|net|org|io|biz|co|in)\\b\\S*)/gi;\nif (urlPattern.test(r.draft_reply || '')) {\n  flags.push('removed_links');\n  r.draft_reply = r.draft_reply.replace(urlPattern, '[link removed]');\n}\n\nr.security_flags = flags.join(', ');\nr.needs_review = flags.length > 0;\nreturn r;"
      },
