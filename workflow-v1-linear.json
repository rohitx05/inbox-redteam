    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.choices?.[0]?.message?.content ?? '';\nconst email = $('Webhook').item.json.body;\n\nlet ai;\nlet parseOk = true;\ntry {\n  ai = JSON.parse(raw);\n} catch (e) {\n  parseOk = false;\n  ai = { category: 'other', summary: '', draft_reply: '', action: 'none', forward_to: '' };\n}\n\nreturn {\n  sender: email.sender,\n  subject: email.subject,\n  body: email.body,\n  category: ai.category ?? 'other',\n  summary: ai.summary ?? '',\n  draft_reply: ai.draft_reply ?? '',\n  action: ai.action ?? 'none',\n  forward_to: ai.forward_to ?? '',\n  parse_ok: parseOk,\n  received_at: new Date().toISOString(),\n};"
      },
